# Add your Ozonetel CloudAgent API key here for local development.
OZONETEL_API_KEY=

# The Ozonetel account username associated with that key.
OZONETEL_USERNAME=

# Secret configured in the Ozonetel agent-event webhook URL.
OZONETEL_WEBHOOK_SECRET=

# Upstash Redis REST credentials for live and historical break events.
# Existing values stay in the linked Vercel project's environment settings.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: comma-separated agent IDs and mode types, if needed.
# OZONETEL_AGENT_IDS=
# OZONETEL_MODE_TYPES=
