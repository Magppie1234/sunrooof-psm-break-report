  "version": 2,
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}]},
    {"source": "/breaks", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}]}
  ],
  "rewrites": [
    {"source": "/breaks", "destination": "/"}
  ]
}
